# Build output only. These patterns are anchored to the repo root on purpose: an
# unanchored "openwrt-mcp" also matches files/lib/upgrade/keep.d/openwrt-mcp and every
# other payload file named after the package, and silently drops them from commits.
/openwrt-mcp
/openwrt-mcp.*
/*.apk

# docs/screenshot.js needs puppeteer-core; it is a tool for regenerating an image, not a
# dependency of the daemon, so it is installed on demand rather than declared.
/node_modules
/package-lock.json
/package.json
