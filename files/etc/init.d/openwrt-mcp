#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/openwrt-mcp

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Policies and tokens are re-read from disk on change, so a reload is only
	# needed to pick up a changed listen address.
	restart
}
